# =============================================================================
# FGCS Reproducibility Artifact - Environment Configuration
# =============================================================================
# This file contains the environment variables required for the automated 
# deployment and execution of the Cloud Continuum experiments.
#
# Copy this file to '.env' and fill in your specific infrastructure parameters.
# =============================================================================

# ── Docker Registry ──────────────────────────────────────────────────────────
# The registry where the microservices and Spark images will be pushed.
REGISTRY=your-docker-registry-user

# ── Infrastructure IP Addresses ──────────────────────────────────────────────
# Public or VPN IP addresses of the gateways for each tier.
# These are used to resolve cross-cluster communication.
CLOUD_IP=1.2.3.4
FOG_IP=5.6.7.8
EDGE_GATEWAY_IP=9.10.11.12

# ── InfluxDB Configuration ──────────────────────────────────────────────────
# Credentials for the time-series database used for real-time monitoring.
INFLUX_USER=admin
INFLUX_PASSWORD=your-secure-password
INFLUX_DB=airwatch

# ── Kafka Configuration ─────────────────────────────────────────────────────
# Bootstrap server address for the Cloud-tier Kafka cluster.
KAFKA_BOOTSTRAP_SERVER=kafka.cloud.svc.cluster.local:9092

# ── Experiment Parameters ───────────────────────────────────────────────────
# Default duration for each automated run (in minutes).
EXPERIMENT_DURATION_MIN=10

# Sampling interval for resource utilization logs (in seconds).
SAMPLING_INTERVAL_SEC=5

# ── OIDC & Identity (Optional) ──────────────────────────────────────────────
# Required only if using the federated identity features described in the paper.
OIDC_ISSUER_URL=https://keycloak.yourdomain.com/realms/stack4things
OIDC_CLIENT_ID=kubernetes
OIDC_CLIENT_SECRET=your-client-secret
